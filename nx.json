{
  "namedInputs": {
    "noMarkdown": [
      "!{projectRoot}/**/*.md"
    ]
  },
  "targetDefaults": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "cache": true
    },
    "dev": {
      "dependsOn": [
        "^dev"
      ]
    },
    "test": {
      "inputs": [
        "noMarkdown",
        "^noMarkdown"
      ]
    },
    "build:watch": {
      "dependsOn": [
        "^build:watch"
      ]
    },
    "serve": {
      "dependsOn": [
        "^serve"
      ]
    },
    "start": {
      "dependsOn": [
        "^start"
      ]
    },
    "deploy": {
      "dependsOn": [
        "^deploy"
      ]
    },
    "logs": {
      "dependsOn": [
        "^logs"
      ]
    },
    "preview": {
      "dependsOn": [
        "^preview"
      ],
      "cache": true
    },
    "astro": {
      "dependsOn": [
        "^astro"
      ]
    }
  },
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "defaultBase": "main",
  "nxCloudAccessToken": "Y2Y2MjJmMGEtMmMxNi00OTlmLTkxOWYtY2I0NTZjYTM1OGY4fHJlYWQtd3JpdGU="
}
